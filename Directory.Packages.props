<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Build / tooling (all projects) -->
  <ItemGroup>
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.85" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.15.0" />
  </ItemGroup>

  <!-- Core runtime dependencies -->
  <ItemGroup>
    <!-- Our own MQTT 3.1.1 / 5 client; the only transport the SDK speaks. -->
    <PackageVersion Include="Mqtt.Client" Version="1.1.0" />
    <!-- Twin / direct-method JSON payloads via source-generated (AOT/trim-safe) serialization. -->
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- net8.0 polyfill: System.IO.Pipelines entered the base reference pack in net9.0. Pinned to 9.0.0
       to match Mqtt.Client's net8 dependency (an 8.0.0 downgrade causes a runtime load failure). -->
  <ItemGroup>
    <PackageVersion Include="System.IO.Pipelines" Version="9.0.0" />
  </ItemGroup>

  <!-- netstandard 2.0/2.1 polyfills (referenced only for those TFMs; see Directory.Build.props). -->
  <ItemGroup>
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
    <PackageVersion Include="System.Threading.Channels" Version="9.0.0" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <!-- Test stack -->
  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.56.35" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.8.0" />
    <!-- In-process MQTT test broker used by the integration tests. -->
    <PackageVersion Include="Mqtt.Client.Testing" Version="1.1.0" />
    <!-- Coverage-guided fuzzing of the wire parsers. -->
    <PackageVersion Include="SharpFuzz" Version="2.1.1" />
  </ItemGroup>

</Project>
