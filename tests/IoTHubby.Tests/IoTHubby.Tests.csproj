<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>

    <!-- Keep the test project NativeAOT-publishable so the AOT gate exercises the SDK. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(AotTest)' == 'true'">true</PublishAot>
    <ILLinkTreatWarningsAsErrors Condition="'$(AotTest)' == 'true'">false</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors Condition="'$(AotTest)' == 'true'">false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- Coverage collector breaks `PublishAot`; include it only for JIT runs. -->
  <ItemGroup Condition="'$(AotTest)' != 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IoTHubby\IoTHubby.csproj" />
  </ItemGroup>

</Project>
