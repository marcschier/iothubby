<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin restore to nuget.org only. Central Package Management forbids ambiguous multi-source
    restore, and machine/user-level feeds must not leak into this repo's restore. All packages,
    including Mqtt.Client and Mqtt.Client.Testing, are published to nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
