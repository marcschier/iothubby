<?xml version="1.0" encoding="utf-8"?>
<!--
  Code-coverage configuration for the CI coverage gate. Scopes measurement to the two shipping
  assemblies (IoTHubby and IoTHubby.Edge) so test/fake/generated code does not skew the number.
  Methods annotated with [ExcludeFromCodeCoverage] (the edge OS-integration glue) are honored
  automatically by the collector.
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]IoTHubby\.dll$</ModulePath>
        <ModulePath>.*[\\/]IoTHubby\.Edge\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <UseVerifiableInstrumentation>False</UseVerifiableInstrumentation>
  </CodeCoverage>
</Configuration>
